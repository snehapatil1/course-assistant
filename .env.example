# ============================================================
# Course Assistant - class endpoint configuration
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored - NEVER commit or share real keys.
# All values below are DUMMY examples.
# ============================================================

# Vision-capable chat LLM (OpenAI-compatible /v1)
CHAT_BASE_URL=http://dobolyi.example:9001/v1
CHAT_API_KEY=sk-dummy-key-placeholder
CHAT_MODEL=example/vision-chat-model

# Text embeddings
TEXT_EMBED_BASE_URL=http://dobolyi.example:9002/v1
TEXT_EMBED_API_KEY=sk-dummy-key-placeholder
TEXT_EMBED_MODEL=example/text-embed-model

# Visual embeddings (image -> vector)
VISUAL_EMBED_BASE_URL=http://dobolyi.example:9003/v1
VISUAL_EMBED_API_KEY=sk-dummy-key-placeholder
VISUAL_EMBED_MODEL=example/visual-embed-model

# Multimodal reranker (query + candidate text/images -> score)
RERANK_BASE_URL=http://dobolyi.example:9004/v1
RERANK_API_KEY=sk-dummy-key-placeholder
RERANK_MODEL=example/rerank-model

# Document parsing (PPTX/PDF -> text + page/slide images)
PARSE_BASE_URL=http://dobolyi.example:9005/v1
PARSE_API_KEY=sk-dummy-key-placeholder
PARSE_MODEL=example/parse-model

# Reproducibility
LLM_TEMPERATURE=0
RANDOM_SEED=123
